{
  "openapi": "3.1.0",
  "info": {
    "title": "Roudio API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/auth/google": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign In With Google",
        "operationId": "signInWithGoogle",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh",
        "operationId": "refreshSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTokens"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign Out",
        "operationId": "signOut",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/plaud/token": {
      "post": {
        "tags": [
          "plaud"
        ],
        "summary": "Plaud Token",
        "operationId": "getPlaudToken",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaudToken"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/recordings/{serial}/{session_id}": {
      "put": {
        "tags": [
          "recordings"
        ],
        "summary": "Start Upload",
        "operationId": "startRecordingUpload",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "serial",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9A-Za-z]{4,32}$",
              "title": "Serial"
            }
          },
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "format": "int64",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordingUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingUpload"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recordings/{recording_id}/parts/{number}": {
      "put": {
        "tags": [
          "recordings"
        ],
        "summary": "Upload Part",
        "operationId": "uploadRecordingPart",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "recording_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Recording Id"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 1,
              "title": "Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingUpload"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/recordings/{recording_id}/complete": {
      "post": {
        "tags": [
          "recordings"
        ],
        "summary": "Complete Upload",
        "operationId": "completeRecordingUpload",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "recording_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Recording Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingUpload"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GoogleSignInRequest": {
        "properties": {
          "client": {
            "type": "string",
            "enum": [
              "android",
              "web"
            ],
            "title": "Client"
          },
          "id_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id Token",
            "description": "Google ID token (Credential Manager)"
          },
          "drive_auth_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Drive Auth Code",
            "description": "One-time authorization code for `openid email https://www.googleapis.com/auth/drive.file`"
          }
        },
        "type": "object",
        "required": [
          "client"
        ],
        "title": "GoogleSignInRequest",
        "description": "Android sends `id_token` (and `drive_auth_code` when Drive is granted). The web sends\nonly `drive_auth_code` from one Google popup; its ID token comes back from the exchange."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "type": "string",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "database"
        ],
        "title": "Health"
      },
      "Me": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "drive_connected": {
            "type": "boolean",
            "title": "Drive Connected"
          }
        },
        "type": "object",
        "required": [
          "email",
          "drive_connected"
        ],
        "title": "Me"
      },
      "PlaudToken": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token",
            "description": "User token for `PlaudDeviceAgent.initSDK`"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "domain": {
            "type": "string",
            "title": "Domain",
            "description": "Host to pass to the SDK, e.g. platform-us.plaud.ai"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_at",
          "domain"
        ],
        "title": "PlaudToken"
      },
      "RecordingUpload": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "uploading",
              "uploaded"
            ],
            "title": "State"
          },
          "part_bytes": {
            "type": "integer",
            "title": "Part Bytes",
            "description": "Size of every part but the last"
          },
          "parts": {
            "type": "integer",
            "title": "Parts",
            "description": "How many parts the whole file takes"
          },
          "received_bytes": {
            "type": "integer",
            "format": "int64",
            "title": "Received Bytes",
            "description": "Bytes stored so far, counted from the start"
          },
          "next_part": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Part",
            "description": "The part to send next; null when all are in"
          }
        },
        "type": "object",
        "required": [
          "id",
          "state",
          "part_bytes",
          "parts",
          "received_bytes",
          "next_part"
        ],
        "title": "RecordingUpload"
      },
      "RecordingUploadRequest": {
        "properties": {
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At",
            "description": "When the recording began, in UTC"
          },
          "zone_offset_seconds": {
            "type": "integer",
            "maximum": 50400.0,
            "minimum": -50400.0,
            "title": "Zone Offset Seconds"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0,
                "format": "int64"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "size_bytes": {
            "type": "integer",
            "maximum": 2147483648.0,
            "exclusiveMinimum": 0.0,
            "format": "int64",
            "title": "Size Bytes"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256",
            "description": "Lower-case hex SHA-256 of the whole file"
          }
        },
        "type": "object",
        "required": [
          "started_at",
          "zone_offset_seconds",
          "size_bytes",
          "sha256"
        ],
        "title": "RecordingUploadRequest"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest"
      },
      "SessionTokens": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "access_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Access Expires At"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "refresh_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Refresh Expires At"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "access_expires_at",
          "refresh_token",
          "refresh_expires_at"
        ],
        "title": "SessionTokens"
      },
      "SignInResult": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "access_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Access Expires At"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "refresh_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Refresh Expires At"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "drive_connected": {
            "type": "boolean",
            "title": "Drive Connected"
          },
          "drive_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Drive Error",
            "description": "Why the Drive grant wasn't saved, if a code was sent"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "access_expires_at",
          "refresh_token",
          "refresh_expires_at",
          "drive_connected"
        ],
        "title": "SignInResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
