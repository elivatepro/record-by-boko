# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://localhost/roudio
# Signs Roudio's own access tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
# The only Google account allowed to sign in.
OWNER_EMAIL=bokotomii@gmail.com
# Google OAuth client IDs whose ID tokens we accept (comma-separated: backend/web client).
GOOGLE_CLIENT_IDS=
# Backend OAuth client, used to exchange the Drive authorization code.
GOOGLE_CLIENT_SECRET=
# Fernet key that encrypts the stored Drive refresh token.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DRIVE_TOKEN_KEY=
# Plaud developer portal credentials. Leave empty to use the fake in development.
PLAUD_CLIENT_ID=
PLAUD_CLIENT_SECRET=
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
# Plaud region API base (US default; Japan: https://platform-jp.plaud.ai/developer/api).
PLAUD_API_BASE=https://platform-us.plaud.ai/developer/api
