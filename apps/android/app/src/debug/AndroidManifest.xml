<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may talk to a local backend over plain HTTP. Release builds can't. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true">
        <!-- adb-only recorder commands for testing on Xiaomi phones, where adb can't tap.
             DUMP is held by the adb shell, not by apps. -->
        <receiver
            android:name=".debug.RecorderCommands"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
