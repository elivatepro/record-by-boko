<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; everything visible is drawn by Compose (RoudioTheme). -->
    <style name="Theme.Roudio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <!-- TurnOnBluetoothActivity: nothing of its own shows, only Android's dialog. -->
    <style name="Theme.Roudio.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
