    <!-- 11a Setup · Welcome -->
    <string name="welcome_title">Your day, written down and easy to find.</string>
    <string name="welcome_body">Roudio works with your Plaud Note Pro. Here’s what it does:</string>
    <string name="welcome_pulls_title">Pulls recordings off your recorder</string>
    <string name="welcome_pulls_body">Over Bluetooth, in the background.</string>
    <string name="welcome_writes_title">Writes them up</string>
    <string name="welcome_writes_body">Who said what, decisions and suggested tasks, each linked to the moment.</string>
    <string name="welcome_backs_title">Backs everything up to your Drive</string>
    <string name="welcome_backs_body">Recordings stay on this phone until you delete them.</string>
    <string name="welcome_footnote">Takes about 3 minutes. Keep your recorder nearby and charged.</string>
    <string name="get_started">Get started</string>

    <!-- 11b Setup · Sign in -->
    <string name="sign_in_title">Sign in with Google</string>
    <string name="sign_in_body">One account does two jobs. It keeps your recordings yours, and it’s where backups go.</string>
    <string name="sign_in_private_title">Your private Roudio</string>
    <string name="sign_in_private_body">Only this account can see your recordings, here or on the web.</string>
    <string name="sign_in_drive_title">Backups in a Roudio folder on your Drive</string>
    <string name="sign_in_drive_body">Roudio only touches the folder it creates.</string>
    <string name="continue_with_google">Continue with Google</string>
    <string name="signing_in">Signing in…</string>
    <string name="not_owner_title">That account can’t open this Roudio</string>
    <string name="not_owner_body">%1$s isn’t the owner. Pick the Google account this Roudio belongs to.</string>
    <string name="that_account">That account</string>
    <string name="sign_in_failed_title">Sign-in didn’t work</string>
    <string name="no_connection">Couldn’t reach Roudio’s server. Check your connection and try again.</string>

